# ---- Required ----
# Postgres connection. In Docker Compose this is set for you.
DATABASE_URL="postgresql://inbox:change-me@localhost:5432/creator_inbox"
# 32-byte base64 master key used to encrypt provider/AI/Telegram keys at rest.
# Generate with: npm run secret:generate   (keep it OUTSIDE the database and backups of the DB)
MASTER_KEY=""
# Public URL of the dashboard, used for links in notifications and for CSRF origin checks.
APP_URL="http://localhost:3000"

# ---- Optional ----
# Set to "true" only behind HTTPS (VPS). Forces Secure cookies.
COOKIE_SECURE="false"
# Worker tuning
WORKER_CONCURRENCY="4"
WORKER_POLL_MS="1000"
# Seed: creates a local owner account if no users exist. Use a throwaway local password.
SEED_OWNER_EMAIL="owner@example.test"
SEED_OWNER_PASSWORD=""
# Webhook signing secret for the simulator's webhook endpoint (any random string).
SIMULATOR_WEBHOOK_SECRET="local-simulator-secret"
# Postgres password used by docker-compose.yml
POSTGRES_PASSWORD="change-me"
# Domain for Caddy HTTPS on the VPS (docker compose --profile proxy)
DOMAIN="inbox.example.com"
